{
  "name": "repodeck",
  "productName": "RepoDeck",
  "version": "2.0.0",
  "description": "Bird's-eye source control for many git repositories",
  "private": true,
  "license": "UNLICENSED",
  "author": {
    "name": "UncleLYHME",
    "email": "iamlyhme@gmail.com",
    "url": "https://github.com/UncleLYHME"
  },
  "homepage": "https://github.com/UncleLYHME/repodeck",
  "repository": {
    "type": "git",
    "url": "https://github.com/UncleLYHME/repodeck.git"
  },
  "bugs": "https://github.com/UncleLYHME/repodeck/issues",
  "main": "out/main/index.js",
  "desktopName": "dev.foundry.RepoDeck.desktop",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "start": "electron-vite preview --noSandbox",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "e2e": "electron-vite build && xvfb-run -a playwright test",
    "check": "pnpm typecheck && pnpm test",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "packageManager": "pnpm@11.1.1",
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.13",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
